.container {
  padding: 0;
  min-height: 100vh;
  background: #eef3f7;
}

/* 英雄区 */
.hero-section {
  background: linear-gradient(145deg, #113448, #0e8f78);
  padding: 80rpx 40rpx 60rpx;
  text-align: center;
}

.avatar-wrapper {
  margin-bottom: 24rpx;
}

.avatar-circle {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.2);
  border: 4rpx solid rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
}

.avatar-letter {
  font-size: 56rpx;
  font-weight: bold;
  color: white;
}

.user-name {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: white;
  margin-bottom: 10rpx;
}

.user-position {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.75);
}

/* KPI区域 */
.kpi-section {
  padding: 30rpx;
  margin-top: -20rpx;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #6c7d89;
  margin-bottom: 20rpx;
}

.kpi-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.kpi-card {
  background: white;
  border-radius: 16rpx;
  padding: 32rpx 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(27,61,78,.06);
}

.kpi-number {
  display: block;
  font-size: 52rpx;
  font-weight: bold;
  color: #0e8f78;
  margin-bottom: 8rpx;
}

.kpi-number.warning {
  color: #f3a83b;
}

.kpi-label {
  display: block;
  font-size: 26rpx;
  color: #6c7d89;
}

/* 菜单区域 */
.menu-section {
  padding: 0 30rpx;
  margin-top: 20rpx;
}

.menu-card {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 16rpx rgba(27,61,78,.06);
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 28rpx 24rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background 0.2s;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #f8fafb;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 44rpx;
  text-align: center;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #10212b;
}

.menu-arrow {
  font-size: 32rpx;
  color: #b8c4cc;
}

/* 设置项 */
.setting-section {
  padding: 0 30rpx;
  margin-top: 20rpx;
}

.setting-item {
  background: white;
  border-radius: 16rpx;
  padding: 28rpx 24rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: 0 4rpx 16rpx rgba(27,61,78,.06);
}

.setting-label {
  font-size: 30rpx;
  color: #10212b;
  font-weight: 500;
}

/* 提示框 */
.tip-box {
  margin: 30rpx;
  background: #f0f9ff;
  border: 1rpx solid #bae6fd;
  border-radius: 12rpx;
  padding: 24rpx;
}

.tip-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #0369a1;
  margin-bottom: 10rpx;
}

.tip-content {
  display: block;
  font-size: 24rpx;
  color: #0c4a6e;
  line-height: 1.7;
}

/* 版本信息 */
.version-info {
  text-align: center;
  padding: 40rpx 0 60rpx;
}

.version-text {
  font-size: 24rpx;
  color: #b8c4cc;
}
.login-card {
  margin: 80rpx 32rpx 0;
  padding: 48rpx 36rpx;
  background: #fff;
  border-radius: 20rpx;
  box-shadow: 0 12rpx 40rpx rgba(18, 48, 68, 0.1);
}

.login-title {
  display: block;
  color: #123044;
  font-size: 40rpx;
  font-weight: 700;
}

.login-subtitle {
  display: block;
  margin: 12rpx 0 36rpx;
  color: #7c8d97;
  font-size: 26rpx;
}

.login-input {
  box-sizing: border-box;
  width: 100%;
  height: 88rpx;
  margin-bottom: 24rpx;
  padding: 0 24rpx;
  border: 1rpx solid #dbe4e8;
  border-radius: 12rpx;
  background: #f7fafb;
}

.login-button {
  color: #fff;
  background: #0e8f78;
  border-radius: 12rpx;
}

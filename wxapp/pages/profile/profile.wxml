<view class="container">
  <view class="login-card" wx:if="{{!loggedIn}}">
    <text class="login-title">登录鑫速录</text>
    <text class="login-subtitle">登录后使用报表上传、复核与分析功能</text>
    <input class="login-input" placeholder="用户名" value="{{username}}" data-field="username" bindinput="onLoginInput"/>
    <input class="login-input" password placeholder="密码" value="{{password}}" data-field="password" bindinput="onLoginInput"/>
    <button class="login-button" bindtap="submitLogin" loading="{{loggingIn}}">登录</button>
  </view>

  <block wx:if="{{loggedIn}}">
  <!-- 英雄区 -->
  <view class="hero-section">
    <view class="avatar-wrapper">
      <view class="avatar-circle">
        <text class="avatar-letter">{{userInfo.avatar || 'Z'}}</text>
      </view>
    </view>
    <text class="user-name">{{userInfo.name || '张经理'}}</text>
    <text class="user-position">{{userInfo.department || '城东支行'}}·{{userInfo.role || '客户经理'}}</text>
  </view>

  <!-- KPI网格 -->
  <view class="kpi-section">
    <view class="section-title">我的任务</view>
    <view class="kpi-grid">
      <view class="kpi-card" bindtap="goToReviewList">
        <text class="kpi-number">{{kpiData.pendingReview}}</text>
        <text class="kpi-label">待复核</text>
      </view>
      <view class="kpi-card" bindtap="goToExceptionList">
        <text class="kpi-number warning">{{kpiData.pendingExceptions}}</text>
        <text class="kpi-label">异常待处理</text>
      </view>
    </view>
  </view>

  <!-- 设置菜单 -->
  <view class="menu-section">
    <view class="menu-card">
      <view class="menu-item" bindtap="goToUploadHistory">
        <text class="menu-icon">📤</text>
        <text class="menu-text">我的上传记录</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToExportReport">
        <text class="menu-icon">📊</text>
        <text class="menu-text">分析报告导出</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToOCRSettings">
        <text class="menu-icon">⚙️</text>
        <text class="menu-text">OCR识别设置</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="goToSecuritySettings">
        <text class="menu-icon">🔒</text>
        <text class="menu-text">数据安全与隐私</text>
        <text class="menu-arrow">›</text>
      </view>
      <view class="menu-item" bindtap="logoutAccount">
        <text class="menu-icon">↪</text>
        <text class="menu-text">退出登录</text>
        <text class="menu-arrow">›</text>
      </view>
    </view>
  </view>

  <!-- 提示框 -->
  <view class="tip-box">
    <text class="tip-title">📋 审计日志说明</text>
    <text class="tip-content">本小程序所有操作均会记录审计日志，包括文件上传、数据修改、报告生成等关键操作，确保数据可追溯、操作可审计。</text>
  </view>

  <!-- 版本信息 -->
  <view class="version-info">
    <text class="version-text">鑫速录 v1.0.0</text>
  </view>
  </block>
</view>

.container {
  padding: 60rpx 40rpx;
  min-height: 100vh;
  background: #fff;
  display: flex;
  flex-direction: column;
}

/* 错误图标 */
.error-icon-wrapper {
  display: flex;
  justify-content: center;
  margin-bottom: 50rpx;
}

.error-icon {
  width: 172rpx;
  height: 172rpx;
  background: linear-gradient(135deg, #e35d6a, #c0392b);
  border-radius: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(227, 93, 106, 0.3);
}

.icon-text {
  font-size: 80rpx;
  color: white;
  font-weight: bold;
}

/* 内容区域 */
.content-section {
  text-align: center;
  margin-bottom: 60rpx;
}

.error-title {
  display: block;
  font-size: 38rpx;
  font-weight: 600;
  color: #10212b;
  margin-bottom: 20rpx;
}

.error-desc {
  display: block;
  font-size: 28rpx;
  color: #6c7d89;
  line-height: 1.6;
  margin-bottom: 24rpx;
  text-align: left;
}

.reason-list {
  text-align: left;
  background: #f8fafb;
  border-radius: 12rpx;
  padding: 28rpx;
}

.reason-item {
  display: block;
  font-size: 26rpx;
  color: #3d4852;
  line-height: 1.8;
  padding: 4rpx 0;
}

/* 操作按钮 */
.action-section {
  margin-bottom: 40rpx;
}

.btn-primary,
.btn-ghost {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-primary {
  background: linear-gradient(135deg, #0e8f78, #1dc7a3);
  color: white;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-ghost {
  background: transparent;
  color: #0e8f78;
  border: 2rpx solid #0e8f78;
}

.btn-ghost::after {
  border: none;
}

/* 提示框 */
.tip-box {
  background: #f0f9ff;
  border: 1rpx solid #bae6fd;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-top: auto;
}

.tip-title {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #0369a1;
  margin-bottom: 10rpx;
}

.tip-content {
  display: block;
  font-size: 24rpx;
  color: #0c4a6e;
  line-height: 1.6;
}

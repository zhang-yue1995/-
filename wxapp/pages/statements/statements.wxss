.container {
  padding-bottom: 120rpx;
  min-height: 100vh;
  background: #eef3f7;
}

/* 信息栏 */
.info-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 30rpx;
  background: white;
}

.info-left {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: flex-start;
  gap: 14rpx;
  margin-right: 18rpx;
}

.enterprise-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #10212b;
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.period-picker {
  max-width: 100%;
}

.period-switcher {
  min-height: 54rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 0 18rpx;
  border: 1rpx solid #dce6eb;
  border-radius: 27rpx;
  background: #f8fafb;
  box-sizing: border-box;
}

.period-switcher.switchable {
  border-color: #61bda7;
  background: #effaf7;
  box-shadow: 0 2rpx 8rpx rgba(14, 143, 120, .08);
}

.period-label {
  font-size: 22rpx;
  color: #6c7d89;
}

.period {
  font-size: 26rpx;
  color: #10212b;
  font-weight: 600;
}

.period-action {
  font-size: 22rpx;
  color: #0e8f78;
  font-weight: 500;
}

.period-single {
  font-size: 21rpx;
  color: #95a5a6;
}

.unit-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 30rpx;
  background: #f8fafb;
  font-size: 24rpx;
  color: #6c7d89;
}

.loading-text {
  color: #0e8f78;
  font-size: 22rpx;
}

/* Tab栏 */
.tab-bar {
  display: flex;
  background: white;
  padding: 0 20rpx;
  border-top: 1rpx solid #f0f2f5;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 27rpx;
  color: #6c7d89;
  position: relative;
}

.tab-item.active {
  color: #0e8f78;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60%;
  height: 4rpx;
  background: #0e8f78;
  border-radius: 2rpx;
}

/* 表格容器 */
.table-container {
  margin: 20rpx;
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
}

.statement-table {
  min-width: 1080rpx;
}

/* 表头 */
.table-header {
  display: flex;
  background: #123044;
  color: white;
  padding: 24rpx 16rpx;
}

.th {
  font-size: 24rpx;
  font-weight: 600;
  text-align: right;
  flex: 1;
}

.th-item {
  text-align: left;
  flex: 1.5;
  padding-left: 10rpx;
}

/* 数据行 */
.table-row {
  display: flex;
  padding: 22rpx 16rpx;
  border-bottom: 1rpx solid #f0f2f5;
  transition: background 0.2s;
}

.table-row:active {
  background: #f8fafb;
}

/* 合计行 */
.total-row {
  background: #f8fafb;
  font-weight: 600;
}

/* 缩进 */
.indent-1 .td-item { padding-left: 40rpx; }
.indent-2 .td-item { padding-left: 70rpx; }

.td {
  font-size: 24rpx;
  color: #10212b;
  text-align: right;
  flex: 1;
}

.td-item {
  text-align: left;
  flex: 1.5;
  padding-left: 10rpx;
}

.td-num.negative {
  color: #e35d6a;
}

/* 底部按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: white;
  box-shadow: 0 -4rpx 16rpx rgba(27,61,78,.08);
}

.btn-approval {
  flex: 1;
  height: 84rpx;
  margin: 0;
  padding: 0 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 0;
  border-radius: 38rpx;
  background: linear-gradient(135deg, #d9982f, #efb24c);
  color: #fff;
  font-size: 25rpx;
  line-height: 1.2;
}

.btn-approval::after { border: 0; }

.btn-secondary,
.btn-primary {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-secondary {
  background: #f0f2f5;
  color: #6c7d89;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #0e8f78, #1dc7a3);
  color: white;
  border: none;
}

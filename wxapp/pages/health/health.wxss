.container {
  padding: 30rpx;
  padding-bottom: 140rpx;
  min-height: 100vh;
  background: #eef3f7;
}

/* 标题行 */
.header-section {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.header-left {
  flex: 1;
}

.header-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #10212b;
  margin-bottom: 8rpx;
}

.header-subtitle {
  display: block;
  font-size: 24rpx;
  color: #6c7d89;
}

/* 评分区域 */
.score-section {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(27,61,78,.06);
}

.score-circle-wrapper {
  flex-shrink: 0;
}

.score-detail {
  text-align: left;
}

.score-label {
  display: block;
  font-size: 24rpx;
  color: #6c7d89;
  margin-bottom: 10rpx;
}

.score-number {
  font-size: 64rpx;
  font-weight: bold;
  color: #10212b;
}

.score-max {
  font-size: 32rpx;
  color: #6c7d89;
}

/* 四宫格 */
.dimension-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.dimension-card {
  background: white;
  border-radius: 16rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(27,61,78,.06);
}

.dimension-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.dimension-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #10212b;
}

.dimension-score {
  font-size: 24rpx;
  color: #6c7d89;
  font-weight: 500;
}

.dimension-status {
  display: block;
  font-size: 22rpx;
  margin-top: 10rpx;
  font-weight: 500;
}

.status-WEAK { color: #e35d6a; }
.status-BELOW_AVERAGE { color: #f3a83b; }
.status-AVERAGE { color: #3d7cf0; }
.status-GOOD { color: #20a96b; }

/* 区块 */
.section {
  background: white;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(27,61,78,.06);
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #10212b;
  margin-bottom: 24rpx;
}

/* 指标卡片 */
.metric-card {
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.metric-card:last-child {
  border-bottom: none;
}

.metric-info {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.metric-name {
  font-size: 28rpx;
  color: #10212b;
  font-weight: 500;
}

.metric-value {
  font-size: 32rpx;
  font-weight: bold;
}

.metric-progress {
  margin-bottom: 12rpx;
}

.metric-status {
  display: block;
  font-size: 24rpx;
}

/* 底部按钮 */
.bottom-action {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: white;
  box-shadow: 0 -4rpx 16rpx rgba(27,61,78,.08);
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #0e8f78, #1dc7a3);
  color: white;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 44rpx;
  border: none;
}

.btn-primary::after {
  border: none;
}

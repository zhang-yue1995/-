.container {
  padding: 30rpx;
  padding-bottom: 40rpx;
  min-height: 100vh;
  background: #eef3f7;
}

/* 标题行 */
.header-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #10212b;
}

.btn-add {
  background: linear-gradient(135deg, #0e8f78, #1dc7a3);
  color: white;
  font-size: 26rpx;
  padding: 14rpx 32rpx;
  border-radius: 20rpx;
  border: none;
  font-weight: 500;
}

.btn-add::after {
  border: none;
}

/* 搜索框 */
.search-bar {
  display: flex;
  align-items: center;
  background: white;
  border-radius: 24rpx;
  padding: 20rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(27,61,78,.06);
}

.search-icon {
  font-size: 28rpx;
  margin-right: 16rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #10212b;
}

/* 统计卡片 */
.stats-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.stat-card {
  background: white;
  border-radius: 16rpx;
  padding: 28rpx;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(27,61,78,.06);
}

.stat-number {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  color: #0e8f78;
  margin-bottom: 8rpx;
}

.stat-number.warning {
  color: #f3a83b;
}

.stat-label {
  display: block;
  font-size: 24rpx;
  color: #6c7d89;
}

/* 企业列表 */
.enterprise-list {
  height: calc(100vh - 500rpx);
}

.enterprise-card {
  background: white;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(27,61,78,.06);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.enterprise-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #10212b;
  flex: 1;
  margin-right: 16rpx;
}

.card-info {
  margin-bottom: 16rpx;
}

.credit-code {
  font-size: 24rpx;
  color: #6c7d89;
}

.card-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 16rpx;
}

.period-summary {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.period-count {
  padding: 4rpx 14rpx;
  border-radius: 16rpx;
  background: #e8f7f2;
  color: #0e8f78;
  font-size: 22rpx;
  font-weight: 600;
}

.meta-item {
  font-size: 24rpx;
  color: #6c7d89;
}

.meta-item.health {
  color: #0e8f78;
  font-weight: 500;
}
.meta-item.unscored { color: #95a5a6; }

.period-list {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin: 2rpx 0 18rpx;
}

.period-list-label {
  flex: none;
  font-size: 22rpx;
  color: #95a5a6;
}

.period-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.period-chips {
  display: inline-flex;
  gap: 12rpx;
  padding-right: 8rpx;
}

.period-chip {
  padding: 8rpx 18rpx;
  border: 1rpx solid #dce6eb;
  border-radius: 22rpx;
  background: #f8fafb;
  color: #5d707d;
  font-size: 22rpx;
  line-height: 1.2;
}

.period-chip.latest {
  border-color: #61bda7;
  background: #effaf7;
  color: #0e8f78;
  font-weight: 600;
}

.card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 16rpx;
  border-top: 1rpx solid #f0f2f5;
}

.manager {
  font-size: 24rpx;
  color: #95a5a6;
}

.view-periods {
  display: flex;
  align-items: center;
  gap: 6rpx;
  color: #0e8f78;
  font-size: 23rpx;
  font-weight: 500;
}

.arrow {
  font-size: 32rpx;
  color: #0e8f78;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  display: block;
  font-size: 30rpx;
  color: #6c7d89;
  margin-bottom: 12rpx;
}

.empty-hint {
  display: block;
  font-size: 24rpx;
  color: #a0aab0;
}

.modal-mask {
  position: fixed; inset: 0; z-index: 1000; display: flex; align-items: center; justify-content: center;
  padding: 30rpx; box-sizing: border-box; background: rgba(11, 31, 43, .58);
}
.add-modal { width: 100%; max-height: 88vh; overflow-y: auto; padding: 30rpx; box-sizing: border-box; background: #fff; border-radius: 26rpx; }
.modal-head { display: flex; align-items: flex-start; justify-content: space-between; padding-bottom: 22rpx; border-bottom: 1rpx solid #eef2f4; }
.modal-title, .modal-step { display: block; }
.modal-title { color: #10212b; font-size: 32rpx; font-weight: 700; }
.modal-step { margin-top: 6rpx; color: #7c8d97; font-size: 21rpx; }
.modal-close { padding: 0 6rpx; color: #8a99a1; font-size: 44rpx; line-height: 1; }
.modal-form { padding: 10rpx 0; }
.modal-field { padding: 16rpx 0; }
.modal-field > text { display: block; margin-bottom: 10rpx; color: #40545f; font-size: 24rpx; }
.modal-field input, .modal-picker { height: 76rpx; padding: 0 20rpx; box-sizing: border-box; border: 1rpx solid #dce6eb; border-radius: 12rpx; background: #f9fbfc; color: #10212b; font-size: 26rpx; }
.modal-picker { display: flex; align-items: center; justify-content: space-between; }
.duplicate-notice { padding: 14rpx 18rpx; border-left: 6rpx solid #f3a83b; border-radius: 10rpx; background: #fff8e8; color: #9b6712; font-size: 22rpx; }
.modal-actions { display: flex; justify-content: flex-end; gap: 16rpx; padding-top: 20rpx; }
.modal-actions button { min-width: 150rpx; height: 72rpx; margin: 0; padding: 0 24rpx; display: flex; align-items: center; justify-content: center; border-radius: 36rpx; font-size: 25rpx; line-height: 1.2; }
.modal-actions button::after, .source-card::after { border: 0; }
.modal-secondary { border: 1rpx solid #dce6eb !important; background: #f7f9fa; color: #637681; }
.modal-primary { background: linear-gradient(135deg, #0e8f78, #43bfa4); color: #fff; }
.draft-summary { margin: 24rpx 0 18rpx; padding: 20rpx; border-radius: 14rpx; background: #eef9f6; }
.draft-summary text { display: block; color: #0e8f78; font-size: 25rpx; font-weight: 600; }
.draft-summary text + text { margin-top: 6rpx; color: #6d807f; font-size: 21rpx; font-weight: 400; }
.source-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 16rpx; }
.source-card { min-height: 190rpx; margin: 0; padding: 20rpx 14rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 1rpx dashed #61bda7; border-radius: 18rpx; background: #f3fbf8; line-height: 1.2; }
.source-wide { grid-column: 1 / -1; min-height: 150rpx; }
.source-icon, .source-title, .source-desc { display: block; }
.source-icon { font-size: 42rpx; }
.source-title { margin-top: 10rpx; color: #10212b; font-size: 26rpx; font-weight: 650; }
.source-desc { margin-top: 8rpx; color: #7c8d97; font-size: 20rpx; }
.temporary-tip { display: block; margin-top: 18rpx; color: #8c9aa2; font-size: 21rpx; line-height: 1.6; }

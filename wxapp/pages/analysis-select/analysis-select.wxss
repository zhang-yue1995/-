.page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 28rpx 28rpx 160rpx;
  background: #eef3f7;
}

.intro-card {
  display: flex;
  flex-direction: column;
  padding: 34rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  color: #fff;
  background: linear-gradient(135deg, #123044 0%, #155a62 62%, #0e8f78 100%);
  border-radius: 24rpx;
  box-shadow: 0 16rpx 36rpx rgba(18, 48, 68, .16);
}

.eyebrow { color: #8be1d0; font-size: 20rpx; letter-spacing: 3rpx; }
.title { margin: 14rpx 0 12rpx; font-size: 38rpx; font-weight: 700; }
.subtitle { color: rgba(255,255,255,.78); font-size: 25rpx; line-height: 1.65; }

.search-bar {
  display: flex;
  align-items: center;
  padding: 22rpx 26rpx;
  margin-bottom: 30rpx;
  background: #fff;
  border: 1rpx solid #dde7eb;
  border-radius: 18rpx;
}
.search-icon { margin-right: 14rpx; color: #0e8f78; font-size: 34rpx; }
.search-bar input { flex: 1; color: #17313f; font-size: 27rpx; }

.section-heading { display:flex; justify-content:space-between; margin: 0 4rpx 18rpx; color:#17313f; font-size:29rpx; font-weight:600; }
.section-heading .count { color:#758995; font-size:24rpx; font-weight:400; }
.report-card { display:flex; gap:20rpx; padding:28rpx; margin-bottom:18rpx; background:#fff; border:2rpx solid transparent; border-radius:20rpx; box-shadow:0 5rpx 18rpx rgba(24,54,68,.05); }
.report-card.selected { border-color:#0e8f78; box-shadow:0 10rpx 28rpx rgba(14,143,120,.14); }
.select-dot { display:flex; align-items:center; justify-content:center; width:34rpx; height:34rpx; margin-top:4rpx; border:2rpx solid #a8bac3; border-radius:50%; flex-shrink:0; }
.selected .select-dot { border-color:#0e8f78; }
.dot-inner { width:20rpx; height:20rpx; background:#0e8f78; border-radius:50%; }
.report-main { flex:1; min-width:0; }
.company { display:block; overflow:hidden; color:#122a37; font-size:29rpx; font-weight:650; text-overflow:ellipsis; white-space:nowrap; }
.meta-row { display:flex; gap:24rpx; margin:14rpx 0 18rpx; color:#738691; font-size:23rpx; }
.tags { display:flex; flex-wrap:wrap; gap:10rpx; }
.tag { padding:7rpx 13rpx; border-radius:8rpx; font-size:21rpx; }
.tag.risk { color:#d16e25; background:#fff4e7; }
.tag.score { color:#0e8f78; background:#e8f7f3; }
.tag.approval { color:#526b78; background:#eef3f5; }
.empty { display:flex; flex-direction:column; align-items:center; padding:100rpx 20rpx; color:#84959f; font-size:26rpx; }
.empty-icon { margin-bottom:16rpx; font-size:72rpx; color:#b9c7ce; }
.bottom-action { position:fixed; right:0; bottom:0; left:0; z-index:10; padding:18rpx 30rpx calc(18rpx + env(safe-area-inset-bottom)); background:rgba(255,255,255,.96); box-shadow:0 -8rpx 24rpx rgba(20,48,62,.08); }
.generate-button { display:flex; align-items:center; justify-content:center; width:100%; height:88rpx; min-height:88rpx; padding:0 28rpx; box-sizing:border-box; color:#fff; font-size:28rpx; font-weight:600; line-height:1.25; text-align:center; white-space:nowrap; background:linear-gradient(135deg,#0e8f78,#22b995); border-radius:44rpx; }
.generate-button[disabled] { color:#fff; background:#b9c8ce; }
.generate-button::after { border:none; }

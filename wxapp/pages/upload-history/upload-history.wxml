<view class="page">
  <view class="page-header">
    <text class="title">{{pendingOnly ? '待复核记录' : '我的上传记录'}}</text>
    <text class="subtitle">按上传时间从新到旧排列</text>
  </view>

  <view class="filter-card">
    <view class="company-search">
      <input placeholder="输入企业名称筛选" value="{{enterpriseName}}" bindinput="onCompanyInput" confirm-type="search" bindconfirm="search" />
      <button bindtap="search">查询</button>
    </view>
    <view class="date-row">
      <picker mode="date" value="{{uploadDate}}" bindchange="onDateChange">
        <view class="date-picker">{{uploadDate || '选择上传日期'}}</view>
      </picker>
      <text wx:if="{{uploadDate}}" class="clear-date" bindtap="clearDate">清除日期</text>
    </view>
  </view>

  <view class="record-list">
    <view wx:for="{{records}}" wx:key="archiveId" class="record-card" bindtap="openRecord" data-item="{{item}}">
      <view class="record-main">
        <view class="record-title-row">
          <text class="enterprise-name">{{item.enterpriseName}}</text>
          <text class="status {{item.pending ? 'pending' : 'done'}}">{{item.statusText}}</text>
        </view>
        <text class="file-name">{{item.fileSummary}}</text>
        <view class="record-meta">
          <text>报表期：{{item.reportPeriod}}</text>
          <text>上传：{{item.uploadTime}}</text>
        </view>
      </view>
      <button class="delete-button" catchtap="removeRecord" data-id="{{item.fileId}}">删除</button>
    </view>
  </view>

  <view class="empty-state" wx:if="{{!loading && records.length === 0}}">
    <text class="empty-icon">📂</text>
    <text class="empty-title">暂无符合条件的上传记录</text>
    <text class="empty-hint">删除后的报表和任务不会继续显示</text>
  </view>
</view>

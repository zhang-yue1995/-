.container {
  padding-bottom: 140rpx;
  min-height: 100vh;
  background: #eef3f7;
}

/* 步骤指示器 */
.steps-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 30rpx 20rpx;
  background: white;
}

.step-item {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.step-num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #dce6eb;
  color: #6c7d89;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}

.step-item.active .step-num {
  background: linear-gradient(135deg, #0e8f78, #1dc7a3);
  color: white;
}

.step-item.completed .step-num {
  background: #20a96b;
  color: white;
}

.step-text {
  font-size: 22rpx;
  color: #6c7d89;
}

.step-item.active .step-text,
.step-item.completed .step-text {
  color: #0e8f78;
  font-weight: 600;
}

.step-line {
  width: 80rpx;
  height: 2rpx;
  background: #dce6eb;
  margin: 0 20rpx;
  margin-bottom: 36rpx;
}

.step-line.active {
  background: #0e8f78;
}

/* 标题行 */
.header-section {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 30rpx;
  background: white;
  border-top: 1rpx solid #f0f2f5;
}

.header-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #10212b;
}

.header-subtitle {
  font-size: 24rpx;
  color: #6c7d89;
}

/* Tab栏 */
.tab-bar {
  display: flex;
  background: white;
  padding: 0 30rpx;
  border-bottom: 1rpx solid #f0f2f5;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 28rpx;
  color: #6c7d89;
  position: relative;
  transition: all 0.3s;
}

.tab-item.active {
  color: #0e8f78;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60%;
  height: 4rpx;
  background: #0e8f78;
  border-radius: 2rpx;
}

/* 警告框 */
.warning-box {
  display: flex;
  align-items: center;
  margin: 20rpx 30rpx;
  padding: 20rpx 24rpx;
  background: #fff9e6;
  border: 1rpx solid #ffe58f;
  border-radius: 12rpx;
  position: sticky;
  top: 0;
  z-index: 60;
  box-sizing: border-box;
  box-shadow: 0 8rpx 20rpx rgba(173, 138, 0, 0.12);
}

.warning-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.warning-text {
  font-size: 24rpx;
  color: #ad8a00;
  flex: 1;
}

.warning-arrow {
  color: #ad8a00;
  font-size: 22rpx;
  white-space: nowrap;
}

/* 表格 */
.table-scroll {
  margin: 20rpx 30rpx;
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
}

.field-table {
  min-width: 850rpx;
}

.field-table.three-amount-table {
  min-width: 1040rpx;
}

.table-header {
  display: flex;
  background: #f8fafb;
  padding: 20rpx 16rpx;
  border-bottom: 1rpx solid #f0f2f5;
}

.th {
  font-size: 24rpx;
  font-weight: 600;
  color: #6c7d89;
}

.th-name { width: 280rpx; flex: none; }
.th-value { width: 190rpx; flex: none; text-align: right; }
.th-status { width: 160rpx; flex: none; text-align: center; }

.table-row {
  display: flex;
  padding: 24rpx 16rpx;
  border-bottom: 1rpx solid #f0f2f5;
  transition: background 0.2s;
}

.table-row:active {
  background: #f8fafb;
}

.table-row.abnormal {
  background: #fff5f5;
}

.table-row.focused {
  background: #fff3cd;
  box-shadow: inset 8rpx 0 0 #f3a83b;
}

.td {
  font-size: 26rpx;
  color: #10212b;
}

.td-name { width: 280rpx; flex: none; }
.td-value { width: 190rpx; flex: none; text-align: right; }
.td-status { width: 160rpx; flex: none; text-align: center; }

.td-value.negative {
  color: #e35d6a;
}

/* 置信度标签 */
.confidence-tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.confidence-high {
  background: #e8f8ee;
  color: #20a96b;
}

.confidence-medium {
  background: #fff9e6;
  color: #f3a83b;
}

.confidence-low {
  background: #fff0f0;
  color: #e35d6a;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #6c7d89;
}

/* 底部按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: white;
  box-shadow: 0 -4rpx 16rpx rgba(27,61,78,.08);
}

.btn-secondary,
.btn-primary {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-secondary {
  background: #f0f2f5;
  color: #6c7d89;
  border: none;
}

.btn-secondary::after {
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #0e8f78, #1dc7a3);
  color: white;
  border: none;
}

.btn-primary::after {
  border: none;
}

/* 编辑弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 999;
}

.edit-modal {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  border-radius: 24rpx 24rpx 0 0;
  z-index: 1000;
  animation: slideUp 0.3s ease;
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 30rpx;
  border-bottom: 1rpx solid #f0f2f5;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #10212b;
}

.modal-close {
  font-size: 36rpx;
  color: #6c7d89;
  padding: 10rpx;
}

.modal-body {
  padding: 30rpx;
}

.field-label {
  display: block;
  font-size: 28rpx;
  color: #10212b;
  font-weight: 500;
  margin-bottom: 12rpx;
}

.field-original {
  display: block;
  font-size: 24rpx;
  color: #6c7d89;
  margin-bottom: 20rpx;
}

.field-input {
  width: 100%;
  height: 80rpx;
  border: 1rpx solid #dce6eb;
  border-radius: 12rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  color: #10212b;
  box-sizing: border-box;
}

.amount-label {
  margin-top: 22rpx;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #f0f2f5;
}

.btn-cancel,
.btn-confirm {
  flex: 1;
  height: 80rpx;
  border-radius: 40rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-cancel {
  background: #f0f2f5;
  color: #6c7d89;
  border: none;
}

.btn-cancel::after {
  border: none;
}

.btn-confirm {
  background: linear-gradient(135deg, #0e8f78, #1dc7a3);
  color: white;
  border: none;
}

.btn-confirm::after {
  border: none;
}

/* 入库完成页 */
.completion-page {
  min-height: 100vh;
  padding: 32rpx 30rpx calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: #f4f7fa;
}

.completion-steps {
  background: #ffffff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
}

.completion-card {
  margin-top: 80rpx;
  padding: 68rpx 40rpx 48rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 12rpx 36rpx rgba(18, 48, 68, 0.08);
  text-align: center;
}

.completion-icon {
  width: 112rpx;
  height: 112rpx;
  margin: 0 auto 32rpx;
  border-radius: 56rpx;
  background: linear-gradient(135deg, #0e8f78, #1dc7a3);
  color: #ffffff;
  font-size: 64rpx;
  line-height: 112rpx;
  font-weight: 700;
}

.completion-title,
.completion-desc {
  display: block;
}

.completion-title {
  color: #10212b;
  font-size: 38rpx;
  font-weight: 700;
}

.completion-desc {
  margin: 20rpx 16rpx 52rpx;
  color: #6c7d89;
  font-size: 27rpx;
  line-height: 1.7;
}

.completion-primary,
.completion-secondary {
  width: 100%;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.completion-primary {
  background: linear-gradient(135deg, #0e8f78, #1dc7a3);
  color: #ffffff;
  border: none;
}

.completion-secondary {
  background: #eef4f5;
  color: #0e8f78;
  border: none;
}
.completion-action-grid { display:grid; grid-template-columns:1fr 1fr; gap:20rpx; width:100%; }
.completion-action-grid button { margin:0; width:100%; height:84rpx; padding:0 12rpx; line-height:1.2; text-align:center; }
.completion-primary.is-outline { background:#ffffff; color:#0e8f78; border:2rpx solid #52b99f; }

.completion-primary::after,
.completion-secondary::after {
  border: none;
}
.completion-validation { width:100%; margin:28rpx 0; padding:24rpx; box-sizing:border-box; border-radius:18rpx; background:#f5f9f8; }
.completion-score { display:flex; flex-direction:column; align-items:center; }
.completion-score-value { color:#0e8f78; font-size:64rpx; font-weight:700; line-height:1; }
.completion-score-label { margin-top:10rpx; color:#61757f; font-size:26rpx; }
.completion-validation-summary { display:flex; justify-content:center; gap:28rpx; margin:22rpx 0; font-size:24rpx; }
.completion-validation-summary .is-passed { color:#1e9c68; }
.completion-validation-summary .is-warning { color:#dd941f; }
.completion-validation-list { max-height:300rpx; text-align:left; }
.completion-validation-row { display:flex; gap:16rpx; padding:18rpx 0; border-top:1rpx solid #e2ebe8; }
.completion-validation-row .validation-icon { display:flex; flex:none; align-items:center; justify-content:center; width:36rpx; height:36rpx; border-radius:50%; color:#fff; font-weight:700; }
.completion-validation-row.passed .validation-icon { background:#27a875; }
.completion-validation-row.warning .validation-icon { background:#e7a237; }
.validation-name,.validation-detail { display:block; }
.validation-name { color:#1f3540; font-size:25rpx; font-weight:600; }
.validation-detail { margin-top:6rpx; color:#748791; font-size:21rpx; line-height:1.5; }
.completion-loading { margin:30rpx 0; color:#83939b; font-size:24rpx; }

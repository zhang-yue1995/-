<view class="container">
  <!-- 标题行 -->
  <view class="header-section">
    <text class="header-title">数据质量</text>
    <text class="header-subtitle">自动校验 {{validationItems.length}} 项</text>
  </view>

  <!-- 评分卡片 -->
  <view class="score-card">
    <view class="score-circle">
      <health-circle score="{{totalScore}}" size="180" />
    </view>
    <view class="score-info">
      <text class="score-label">综合评分</text>
      <text class="score-value">{{totalScore}}</text>
      <text class="score-unit">/100</text>
    </view>
    <status-tag type="{{riskLevelType}}" text="{{riskLevelText}}"/>
  </view>

  <!-- 校验结果列表 -->
  <view class="section">
    <text class="section-title">校验结果</text>

    <block wx:for="{{validationItems}}" wx:key="id">
      <view class="validation-item {{item.passed ? 'passed' : 'failed'}}">
        <view class="item-icon">{{item.passed ? '✓' : '✕'}}</view>
        <view class="item-content">
          <text class="item-name">{{item.name}}</text>
          <text class="item-desc" wx:if="{{item.desc}}">{{item.desc}}</text>
        </view>
        <text class="item-status">{{item.passed ? '通过' : '异常'}}</text>
      </view>
    </block>
  </view>

  <!-- 待处理异常 -->
  <view class="section" wx:if="{{exceptions.length > 0}}">
    <text class="section-title warning">待处理异常 ({{exceptions.length}})</text>

    <block wx:for="{{exceptions}}" wx:key="id">
      <view class="exception-card">
        <view class="exception-header">
          <text class="exception-level level-{{item.level}}">{{item.levelText}}</text>
          <text class="exception-name">{{item.name}}</text>
        </view>
        <text class="exception-desc">{{item.description}}</text>
        <button class="btn-handle" bindtap="handleException" data-id="{{item.id}}">处理</button>
      </view>
    </block>
  </view>

  <!-- 底部按钮 -->
  <view class="bottom-action">
    <button
      class="btn-primary"
      bindtap="generateReport"
      disabled="{{hasUnhandledExceptions}}"
    >
      {{hasUnhandledExceptions ? '请先处理异常' : '生成分析报告'}}
    </button>
  </view>
</view>

.container {
  padding: 30rpx;
  padding-bottom: 140rpx;
  min-height: 100vh;
  background: #eef3f7;
}

/* 标题行 */
.header-section {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 30rpx;
}

.header-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #10212b;
}

.generated-badge {
  display: inline-block;
  background: #e8f8ee;
  color: #20a96b;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 10rpx;
  font-weight: 500;
}

.generate-time {
  font-size: 24rpx;
  color: #6c7d89;
  margin-top: 8rpx;
}

/* 报告卡片 */
.report-card {
  background: white;
  border-radius: 20rpx;
  padding: 32rpx;
  box-shadow: 0 4rpx 16rpx rgba(27,61,78,.06);
}

/* 区块 */
.section-block {
  padding: 28rpx 0;
  border-bottom: 1rpx solid #f0f2f5;
}

.section-block:last-of-type {
  border-bottom: none;
}

.section-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.section-icon {
  font-size: 32rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #10212b;
}

.section-header.warning .section-title {
  color: #e35d6a;
}

.section-header.success .section-title {
  color: #20a96b;
}

.section-header.info .section-title {
  color: #3d7cf0;
}

/* 内容文本 */
.section-content {
  display: block;
  font-size: 28rpx;
  color: #3d4852;
  line-height: 1.7;
  text-align: justify;
}

/* 风险列表 */
.risk-list {
  margin-top: 10rpx;
}

.risk-item {
  display: flex;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f5f5f5;
}

.risk-item:last-child {
  border-bottom: none;
}

.risk-level {
  font-size: 22rpx;
  font-weight: 600;
  padding: 6rpx 14rpx;
  border-radius: 10rpx;
  height: fit-content;
  flex-shrink: 0;
}

.level-HIGH {
  background: #fff0f0;
  color: #e35d6a;
}

.level-MEDIUM {
  background: #fff9e6;
  color: #f3a83b;
}

.risk-content {
  flex: 1;
}

.risk-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #10212b;
  margin-bottom: 8rpx;
}

.risk-desc {
  display: block;
  font-size: 26rpx;
  color: #6c7d89;
  line-height: 1.6;
}

/* 积极因素 */
.section-block.positive .section-content {
  color: #20a96b;
}

/* 建议列表 */
.suggestion-list {
  margin-top: 10rpx;
}

.suggestion-item {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 0;
  align-items: flex-start;
}

.suggestion-num {
  width: 40rpx;
  height: 40rpx;
  background: linear-gradient(135deg, #0e8f78, #1dc7a3);
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: 600;
  flex-shrink: 0;
}

.suggestion-text {
  flex: 1;
  font-size: 27rpx;
  color: #3d4852;
  line-height: 1.6;
  padding-top: 6rpx;
}

/* 免责声明 */
.disclaimer {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #f8fafb;
  border-radius: 12rpx;
}

.disclaimer-text {
  font-size: 22rpx;
  color: #95a5a6;
  line-height: 1.6;
}

/* 底部按钮组 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  background: white;
  box-shadow: 0 -4rpx 16rpx rgba(27,61,78,.08);
}

.btn-secondary,
.btn-primary {
  flex: 1;
  height: 84rpx;
  border-radius: 42rpx;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.btn-secondary {
  background: #f0f2f5;
  color: #6c7d89;
  border: none;
}

.btn-primary {
  background: linear-gradient(135deg, #0e8f78, #1dc7a3);
  color: white;
  border: none;
}

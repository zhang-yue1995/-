.hero-banner {
  background: linear-gradient(145deg, #113448, #0e8f78);
  padding: 60rpx 40rpx;
  border-radius: 0 0 40rpx 40rpx;
  color: white;
}

.badge {
  display: inline-block;
  background: rgba(255, 255, 255, 0.2);
  padding: 8rpx 24rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  margin-bottom: 30rpx;
}

.title {
  font-size: 44rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  line-height: 1.3;
}

.subtitle {
  font-size: 26rpx;
  opacity: 0.9;
}
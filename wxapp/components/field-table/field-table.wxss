.table-container {
  background: white;
  border-radius: 28rpx;
  overflow: hidden;
}

.table-header {
  display: flex;
  background: #f2f7f9;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e8eef1;
}

.th {
  padding: 16rpx 20rpx;
  font-size: 24rpx;
  color: #526a76;
  font-weight: 600;
}

.th-name { flex: 2; }
.th-value { flex: 1.5; text-align: right; }
.th-status { flex: 1; text-align: center; }

.table-body {
  max-height: 600rpx;
}

.table-row {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #e8eef1;
  transition: background 0.2s;
}

.table-row.low-confidence {
  background: #fff9f0;
}

.table-row:active {
  background: #f7fbfa;
}

.td {
  padding: 0 20rpx;
  font-size: 26rpx;
}

.td-name { flex: 2; color: #10212b; }
.td-value { flex: 1.5; text-align: right; font-family: monospace; }
.td-status { flex: 1; display: flex; justify-content: center; }
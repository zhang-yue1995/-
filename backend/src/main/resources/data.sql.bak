INSERT INTO financial_analysis_report (id, archive_id, enterprise_id, report_title, report_type, executive_summary, generation_method, word_count, generated_by, generated_at, created_time) VALUES
(1, 1, 1, 'xxx科技有限公司2025年第四季度综合财务分析报告', 'COMPREHENSIVE',
 '{"summary":"xxx科技2025Q4实现营收8,920.60万元，同比增长8.38%，净利润456.80万元，同比增长14.62%。公司整体保持增长态势，但需关注流动性风险。","key_findings":["营收稳步增长，盈利能力持续改善","流动比率和速动比率偏低，存在短期偿债压力","经营现金流520.30万元，较上季度的480.20万元有所改善","资产负债率62.72%，处于行业较高水平"],"risk_level":"高风险(71分)","recommendations":["建议优化营运资本结构，适当缩短账期","考虑引入长期资金替代部分短期借款","加大应收账款催收力度"]}',

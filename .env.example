# 首次部署必须修改为高强度密码
ADMIN_PASSWORD=ChangeMe_Admin_2026!
MANAGER_PASSWORD=ChangeMe_Manager_2026!
TOKEN_VALID_HOURS=12

# 管理后台访问地址；上线时改成真实 HTTPS 域名
PUBLIC_ORIGIN=http://localhost:8080
WEB_PORT=8080

# 首次验收可设为 true 载入与原始报表一致的样例数据；生产数据环境应为 false
DEMO_DATA_ENABLED=true
SWAGGER_ENABLED=false

# mock 仅用于无 OCR 服务时验收流程，会生成模拟字段，严禁用于生产数据
# 生产请设为 http，并配置下方标准化 OCR 适配服务
AI_PROVIDER=mock
OCR_HTTP_ENDPOINT=
OCR_HTTP_TOKEN=
OCR_CONNECT_TIMEOUT_MS=10000
OCR_READ_TIMEOUT_MS=120000

# H2 数据库账号；单机部署可保持默认，备份请见 DEPLOYMENT.md
DB_PASSWORD=
